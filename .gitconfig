[user]
	name = Neil Lin
	email = neil.lin@commscope.com
[alias]
        bf  = branch -f
        br  = branch
        cam = commit --amend -m
        cb  = checkout -b
        cm  = commit -m
        co  = checkout
        di  = diff
        dif = diff
        la  = log --oneline --decorate --graph --all
        lo  = log --oneline
        ps  = p4 submit
        ra  = rebase --abort
        rc  = rebase --continue
        ri  = rebase -i
        st  = status
[pull]
	rebase = false
[core]
	quotepath = false
[init]
	defaultBranch = main
